rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Explicit allowlist and verified Google email are required for all reads.
    // The allowlist collection itself remains server-admin only.
    function isAllowed() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/allowlist/$(request.auth.token.email));
    }

    match /entities/{entityId} {
      allow read: if isAllowed();
      allow write: if false;
    }

    match /edges/{edgeId} {
      allow read: if isAllowed();
      allow write: if false;
    }

    match /documents/{docId} {
      allow read: if isAllowed();
      // Client intake is a candidate, never authenticated evidence verification.
      allow create: if isAllowed()
        && request.resource.data.uploader_uid == request.auth.uid
        && request.resource.data.processing_status == 'NEEDS_REVIEW';
      allow update, delete: if false;
    }

    match /audit_log/{logId} {
      allow read: if isAllowed();
      allow write: if false;
    }

    match /allowlist/{email} {
      allow read, write: if false;
    }
  }
}
