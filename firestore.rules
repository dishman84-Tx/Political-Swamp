rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Allow any authenticated Google user during setup
    function isAllowed() {
      return request.auth != null;
    }

    // Entities — read-only for authenticated allowlisted users
    match /entities/{entityId} {
      allow read: if isAllowed();
      allow write: if false; // Only Python admin SDK writes
    }

    // Edges — read-only
    match /edges/{edgeId} {
      allow read: if isAllowed();
      allow write: if false;
    }

    // Documents — team can log uploads, only admin can update status
    match /documents/{docId} {
      allow read: if isAllowed();
      allow create: if isAllowed();
      allow update, delete: if false; // Python admin SDK only
    }

    // Audit log — read-only
    match /audit_log/{logId} {
      allow read: if isAllowed();
      allow write: if false; // Python admin SDK only
    }

    // Allowlist — fully locked, admin SDK only
    match /allowlist/{email} {
      allow read, write: if false;
    }
  }
}
